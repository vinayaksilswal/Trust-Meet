{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "TRUST_MEET_API_URL" }
      ]
    },
    "api": {
      "root": "services/api",
      "framework": "fastapi",
      "entrypoint": "vercel_app:app"
    }
  },
  "daemons": {
    "maintenance": {
      "root": "services/api",
      "entrypoint": "Dockerfile.worker",
      "instances": { "bom1": 1 }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
