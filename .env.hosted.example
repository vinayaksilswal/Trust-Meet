# Vercel API and maintenance environment. Set real secrets in project settings.
ENVIRONMENT=production
WEB_ORIGIN=https://meet.example.com
WEB_PROXY_SECRET=
# Next.js runtime uses the same generated secret. Vercel supplies TRUST_MEET_API_URL.
TRUST_MEET_WEB_PROXY_SECRET=
DATABASE_URL=postgresql+psycopg://app:password@db.example.com/trustmeet?sslmode=verify-full&sslrootcert=system
REDIS_URL=rediss://default:password@redis.example.com:6379/0
# Use a verified Resend sender domain. The API key can also come from the Vercel integration.
RESEND_API_KEY=
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_SENDER=no-reply@example.com
MEDIA_PROVIDER=livekit
# Select realtimekit and add the scoped token when using Cloudflare instead of LiveKit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_REALTIMEKIT_APP_ID=
CLOUDFLARE_API_TOKEN=
REALTIMEKIT_VIDEO_PRESET=trust_meet_video
REALTIMEKIT_AUDIO_PRESET=trust_meet_audio
REALTIMEKIT_TEXT_PRESET=trust_meet_text
LIVEKIT_API_URL=https://your-project.livekit.cloud
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ENABLE_DEV_AGE_ASSURANCE=false
PUBLIC_CONVERSATIONS=false
ENABLE_CONVERSATIONS=false
ENABLE_MATCHMAKING=false
ENABLE_PRIVATE_ROOMS=false
# Razorpay subscriptions. Create a monthly plan in the Razorpay dashboard and a webhook
# to https://<your-domain>/api/billing/webhook for the order.paid and subscription.* events.
ENABLE_BILLING=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional. Leave empty to sell only day passes.
RAZORPAY_PLUS_PLAN_ID=
PLUS_PRICE_INR=199
# Premium day passes (gender filter, region filter, priority matching), in whole rupees.
PASS_PRICE_1D_INR=999
PASS_PRICE_3D_INR=1999
PASS_PRICE_7D_INR=2999
# Public web settings (Next.js). These are visible in the browser; never put secrets here.
NEXT_PUBLIC_SITE_URL=https://meet.example.com
NEXT_PUBLIC_SITE_INDEXABLE=false
NEXT_PUBLIC_PLUS_PRICE_INR=199
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
NEXT_PUBLIC_JURISDICTION=
