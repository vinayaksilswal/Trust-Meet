# Vercel API and maintenance environment. Set real secrets in project settings.
ENVIRONMENT=production
WEB_ORIGIN=https://meet.example.com
WEB_PROXY_SECRET=
# Next.js runtime uses the same generated secret. Vercel supplies TRUST_MEET_API_URL.
TRUST_MEET_WEB_PROXY_SECRET=
DATABASE_URL=postgresql+psycopg://app:password@db.example.com/trustmeet?sslmode=verify-full&sslrootcert=system
REDIS_URL=rediss://default:password@redis.example.com:6379/0
# Use a verified Resend sender domain. The API key can also come from the Vercel integration.
RESEND_API_KEY=
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_SENDER=no-reply@example.com
MEDIA_PROVIDER=livekit
# Select realtimekit and add the scoped token when using Cloudflare instead of LiveKit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_REALTIMEKIT_APP_ID=
CLOUDFLARE_API_TOKEN=
REALTIMEKIT_VIDEO_PRESET=trust_meet_video
REALTIMEKIT_AUDIO_PRESET=trust_meet_audio
REALTIMEKIT_TEXT_PRESET=trust_meet_text
LIVEKIT_API_URL=https://your-project.livekit.cloud
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ENABLE_DEV_AGE_ASSURANCE=false
PUBLIC_CONVERSATIONS=false
ENABLE_CONVERSATIONS=false
ENABLE_MATCHMAKING=false
ENABLE_PRIVATE_ROOMS=false
